{
    "name":  "loomstead",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "description":  "Narrative-primary explainable multi-agent runtime research environment.",
    "scripts":  {
                    "start":  "python scripts/start_server.py",
                    "check":  "python scripts/check.py",
                    "smoke":  "python scripts/smoke_test.py",
                    "llm:smoke":  "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:AGENT_TOWN_REQUIRE_REAL_LLM_SMOKE='1'; & python scripts/smoke_test.py\"",
                    "eval:rule":  "python scripts/run_agent_eval.py",
                    "eval:process":  "python scripts/run_agent_eval.py --suite process",
                    "eval:process:full":  "python scripts/run_agent_eval.py --suite process --full",
                    "eval:process:export":  "python scripts/run_agent_eval.py --suite process --export-dir .run/eval-runs",
                    "eval:stability":  "python scripts/run_agent_eval.py --suite stability",
                    "eval:stability:export":  "python scripts/run_agent_eval.py --suite stability --export-dir .run/eval-runs",
                    "eval:domain":  "python scripts/run_agent_eval.py --suite domain",
                    "eval:domain:full":  "python scripts/run_agent_eval.py --suite domain --full",
                    "eval:domain:export":  "python scripts/run_agent_eval.py --suite domain --export-dir .run/eval-runs",
                    "eval:archive:check":  "python scripts/index_eval_runs.py --runs-dir .run/eval-runs",
                    "eval:archive:index":  "python scripts/index_eval_runs.py --runs-dir .run/eval-runs --write-index",
                    "eval:archive:drift":  "python scripts/index_eval_runs.py --runs-dir .run/eval-runs --write-drift-report",
                    "content:check":  "python scripts/check_npc_codex.py",
                    "model:check":  "python scripts/check_model_config.py",
                    "client:env":  "python scripts/check_game_client_env.py",
                    "client:open":  "powershell -ExecutionPolicy Bypass -File scripts/open_godot_project.ps1",
                    "client:open:check":  "powershell -ExecutionPolicy Bypass -File scripts/open_godot_project.ps1 -DryRun",
                    "client:run":  "powershell -ExecutionPolicy Bypass -File scripts/open_godot_project.ps1 -Run",
                    "client:run:legacy":  "powershell -ExecutionPolicy Bypass -File scripts/open_godot_project.ps1 -Run -Scene res://scenes/main.tscn",
                    "client:run:check":  "powershell -ExecutionPolicy Bypass -File scripts/open_godot_project.ps1 -Run -DryRun",
                    "client:run:legacy:check":  "powershell -ExecutionPolicy Bypass -File scripts/open_godot_project.ps1 -Run -Scene res://scenes/main.tscn -DryRun",
                    "asset:check":  "python scripts/check_asset_manifest.py",
                    "context:brief":  "python scripts/build_agent_context.py",
                    "context:check":  "python scripts/build_agent_context.py --check",
                    "context:docs":  "python scripts/build_agent_context.py --docs"
                },
    "engines":  {
                    "node":  "\u003e=18.0.0"
                }
}
