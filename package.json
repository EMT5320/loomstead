{
  "name": "loomstead",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An observability-first multi-agent runtime for tracing, debugging, and auditing autonomous behavior.",
  "scripts": {
    "start": "node scripts/py.mjs scripts/start_server.py",
    "check": "node scripts/py.mjs scripts/check.py",
    "smoke": "node scripts/py.mjs scripts/smoke_test.py",
    "llm:smoke": "node scripts/py.mjs --env LOOMSTEAD_REQUIRE_REAL_LLM_SMOKE=1 scripts/smoke_test.py",
    "eval:rule": "node scripts/py.mjs scripts/run_agent_eval.py",
    "eval:process": "node scripts/py.mjs scripts/run_agent_eval.py --suite process",
    "eval:process:full": "node scripts/py.mjs scripts/run_agent_eval.py --suite process --full",
    "eval:process:export": "node scripts/py.mjs scripts/run_agent_eval.py --suite process --export-dir .run/eval-runs",
    "eval:stability": "node scripts/py.mjs scripts/run_agent_eval.py --suite stability",
    "eval:stability:long": "node scripts/py.mjs scripts/run_agent_eval.py --suite stability --hours 72",
    "eval:stability:determinism": "node scripts/py.mjs scripts/run_agent_eval.py --suite stability --hours 72 --determinism-check --repeats 3",
    "eval:stability:export": "node scripts/py.mjs scripts/run_agent_eval.py --suite stability --export-dir .run/eval-runs",
    "eval:stability:long:export": "node scripts/py.mjs scripts/run_agent_eval.py --suite stability --hours 72 --export-dir .run/eval-runs",
    "eval:domain": "node scripts/py.mjs scripts/run_agent_eval.py --suite domain",
    "eval:domain:full": "node scripts/py.mjs scripts/run_agent_eval.py --suite domain --full",
    "eval:domain:export": "node scripts/py.mjs scripts/run_agent_eval.py --suite domain --export-dir .run/eval-runs",
    "eval:robustness": "node scripts/py.mjs scripts/run_agent_eval.py --suite robustness",
    "eval:robustness:export": "node scripts/py.mjs scripts/run_agent_eval.py --suite robustness --export-dir .run/eval-runs",
    "eval:audit": "node scripts/py.mjs scripts/run_agent_eval.py --suite audit",
    "eval:audit:export": "node scripts/py.mjs scripts/run_agent_eval.py --suite audit --export-dir .run/eval-runs",
    "eval:audit:packet": "node scripts/py.mjs scripts/build_audit_reviewer_packet.py",
    "eval:audit:llm-contract": "node scripts/py.mjs scripts/run_audit_llm_smoke.py --export-dir .run/eval-runs",
    "eval:audit:llm-contract:full": "node scripts/py.mjs scripts/run_audit_llm_smoke.py --all-scenarios --export-dir .run/eval-runs",
    "eval:audit:llm-smoke": "node scripts/py.mjs --env LOOMSTEAD_REQUIRE_REAL_AUDIT_LLM_SMOKE=1 scripts/run_audit_llm_smoke.py --live --export-dir .run/eval-runs",
    "eval:audit:llm-smoke:full": "node scripts/py.mjs --env LOOMSTEAD_REQUIRE_REAL_AUDIT_LLM_SMOKE=1 scripts/run_audit_llm_smoke.py --live --all-scenarios --export-dir .run/eval-runs",
    "eval:audit:llm-supplement": "node scripts/py.mjs scripts/build_audit_llm_supplement.py",
    "eval:archive:check": "node scripts/py.mjs scripts/index_eval_runs.py --runs-dir .run/eval-runs",
    "eval:archive:index": "node scripts/py.mjs scripts/index_eval_runs.py --runs-dir .run/eval-runs --write-index",
    "eval:archive:drift": "node scripts/py.mjs scripts/index_eval_runs.py --runs-dir .run/eval-runs --write-drift-report",
    "eval:archive:promote": "node scripts/py.mjs scripts/index_eval_runs.py --runs-dir .run/eval-runs --promote",
    "eval:reviewer:packet": "node scripts/py.mjs scripts/build_eval_reviewer_packet.py",
    "eval:human-rating:packet": "node scripts/py.mjs scripts/build_human_rating_pilot_packet.py",
    "research:evidence:check": "node scripts/py.mjs scripts/check_research_evidence.py",
    "content:check": "node scripts/py.mjs scripts/check_npc_codex.py",
    "schema:check": "node scripts/py.mjs scripts/check_schema_registry.py",
    "model:check": "node scripts/py.mjs scripts/check_model_config.py",
    "client:env": "node scripts/py.mjs scripts/check_game_client_env.py",
    "client:open": "powershell -ExecutionPolicy Bypass -File scripts/open_godot_project.ps1",
    "client:open:check": "powershell -ExecutionPolicy Bypass -File scripts/open_godot_project.ps1 -DryRun",
    "client:run": "powershell -ExecutionPolicy Bypass -File scripts/open_godot_project.ps1 -Run",
    "client:run:legacy": "powershell -ExecutionPolicy Bypass -File scripts/open_godot_project.ps1 -Run -Scene res://scenes/main.tscn",
    "client:run:check": "powershell -ExecutionPolicy Bypass -File scripts/open_godot_project.ps1 -Run -DryRun",
    "client:run:legacy:check": "powershell -ExecutionPolicy Bypass -File scripts/open_godot_project.ps1 -Run -Scene res://scenes/main.tscn -DryRun",
    "asset:check": "node scripts/py.mjs scripts/check_asset_manifest.py",
    "showcase:check": "node scripts/py.mjs scripts/check_showcase.py",
    "portfolio:check": "node scripts/py.mjs scripts/check_portfolio_entry.py",
    "portfolio:snippets": "node scripts/py.mjs scripts/build_portfolio_evidence_snippets.py",
    "portfolio:verify": "npm run portfolio:snippets && npm run portfolio:check && npm run showcase:check",
    "paper:tooling": "node scripts/py.mjs scripts/check_paper_tooling.py --json",
    "paper:tables": "node scripts/py.mjs scripts/paper_extract_eval_tables.py",
    "paper:figures": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/render_mermaid_figures.ps1",
    "paper:figures:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/render_mermaid_figures.ps1 -DryRun",
    "paper:build": "latexmk -pdf -cd -interaction=nonstopmode -halt-on-error -outdir=build paper/latex/main.tex",
    "paper:check": "node scripts/py.mjs scripts/check_paper_tooling.py --json && node scripts/py.mjs scripts/paper_extract_eval_tables.py && latexmk -pdf -cd -interaction=nonstopmode -halt-on-error -outdir=build paper/latex/main.tex",
    "context:brief": "node scripts/py.mjs scripts/build_agent_context.py",
    "context:resume": "node scripts/py.mjs scripts/build_agent_context.py --resume",
    "context:handoff": "node scripts/py.mjs scripts/build_agent_context.py --handoff",
    "context:check": "node scripts/py.mjs scripts/build_agent_context.py --check",
    "context:docs": "node scripts/py.mjs scripts/build_agent_context.py --docs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.15.0"
  }
}
