# 本地生成文件
node_modules/
.DS_Store
*.log

# 实验导出
exports/

# 跨家里 / 公司环境需要复用的研究证据纳入 Git 候选；
# 其他 .run 临时文件继续忽略，避免把 Godot 缓存、截图和一次性临时文件混入提交。
.run/*
!.run/eval-runs/
!.run/eval-runs/**
!.run/eval-promoted/
!.run/eval-promoted/**
!.run/eval-reviewer-packets/
!.run/eval-reviewer-packets/**
!.run/process-llm-evidence/
!.run/process-llm-evidence/**

__pycache__/
*.pyc
.venv/
*.tmp

# 本地 AI 工具设置
CLAUDE.local.md
.claude/*
!.claude/rules/
!.claude/rules/**
!.claude/workflows/
!.claude/workflows/**
.claude/settings.local.json

config/models.json
config/models.local.json

# Godot 本地导入缓存
clients/godot/.godot/
clients/godot/.run/

# Paper build artifacts
paper/latex/build/
paper/latex/*.aux
paper/latex/*.bbl
paper/latex/*.bcf
paper/latex/*.blg
paper/latex/*.fls
paper/latex/*.fdb_latexmk
paper/latex/*.out
paper/latex/*.pdf
paper/latex/*.run.xml
paper/latex/*.synctex.gz
